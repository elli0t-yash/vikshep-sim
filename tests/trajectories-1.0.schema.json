{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trajectories.json, format_version 1.0 (docs/EXPORT3D.md, section 3)",
  "description": "Structure of the file. The fixed-precision number format, the key order and the line layout are checked by tests/check_export3d.py, JSON Schema cannot express them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "unit", "spec_oid", "min_energy_GeV", "max_tracks_per_event", "events_requested", "events"],
  "properties": {
    "format_version": {"const": "1.0"},
    "unit": {"const": "mm"},
    "spec_oid": {"type": "string", "pattern": "^[0-9a-f]{28}$"},
    "min_energy_GeV": {"type": "number", "minimum": 0, "maximum": 10000},
    "max_tracks_per_event": {"const": 500},
    "events_requested": {"type": "integer", "minimum": 1, "maximum": 100},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "tracks_total", "dropped_tracks", "tracks"],
        "properties": {
          "event_id": {"type": "integer", "minimum": 0},
          "tracks_total": {"type": "integer", "minimum": 1},
          "dropped_tracks": {"type": "integer", "minimum": 0},
          "tracks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["track_id", "parent_id", "pdg", "charge", "kinetic_energy_start_GeV", "points"],
              "properties": {
                "track_id": {"type": "integer", "minimum": 1},
                "parent_id": {"type": "integer", "minimum": 0},
                "pdg": {"type": "integer"},
                "charge": {"type": "integer"},
                "kinetic_energy_start_GeV": {"type": "number", "minimum": 0},
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
                }
              }
            }
          }
        }
      }
    }
  }
}
